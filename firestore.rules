rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{id} {
      // Anyone can send a question (size-limited); only you can list, answer or delete.
      allow create: if request.resource.data.keys().hasOnly(['q','name','skin','flags','status','ai','lang','t'])
                    && request.resource.data.q is string && request.resource.data.q.size() < 1000
                    && request.resource.data.status == 'pending';
      allow get: if true;   // the asker reads their own question by its random id
      allow list, update, delete: if request.auth != null && request.auth.token.email == 'ADMIN@EMAIL.COM';
    }
  }
}
